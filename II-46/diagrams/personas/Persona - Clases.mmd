style Persona fill:#2962FF,color:#ffffff,stroke:#2962FF
style PersonaService fill:#00C853,color:#ffffff,stroke:#00C853
style PersonaDB fill:#AA00FF,color:#ffffff,stroke:#AA00FF
style DbHelper fill:#FF6D00,color:#ffffff,stroke:#FF6D00
style FormPersona fill:#0D47A1,stroke:#0B3C91,color:#ffffff
style SwalUtils fill:#EC407A,stroke:#C2185B,color:#ffffff
